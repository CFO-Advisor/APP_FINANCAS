# Copie este arquivo para .env.local e preencha com os valores do seu projeto Supabase
# Settings > API no painel do Supabase

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Integração somente-leitura com o app "Investor" (painel Investimentos).
# CARTEIRA_API_URL: base do app Investor (padrão http://127.0.0.1:8080).
# CARTEIRA_INTEGRATION_TOKEN: token Bearer usado na rota /api/carteira.
# Sem o token (ou com URL inválida) o painel mostra "não configurada" em vez de erro.
CARTEIRA_API_URL=http://127.0.0.1:8080
CARTEIRA_INTEGRATION_TOKEN=

# Classificação de transações por IA (gateway OpenAI-compatible)
# AI_API_BASE=https://seu-gateway/v1
# AI_API_KEY=
# AI_MODEL=auto
